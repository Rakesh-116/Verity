AI_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional Amazon Bedrock provider. Keep Groq/OpenAI configured as local fallbacks.
AWS_REGION=ap-southeast-2
AWS_PROFILE=verity-dev
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Optional local fallback when the primary provider is rate-limited (Ollama must be running).
# AI_FALLBACK_PROVIDER=ollama
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_BASE_URL=http://localhost:11434/v1
