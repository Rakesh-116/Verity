# Copy to .env and fill in only what you use. Never commit .env.

# Which model answers the requests: groq, openai, or bedrock.
# Without a key, the simulator runs the labelled scripted demo.
AI_PROVIDER=groq

# Groq (default provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Amazon Bedrock (Converse API). Use an IAM user with a Bedrock-only policy, not an admin user.
# Set up the profile with: aws configure --profile verity-dev
AWS_PROFILE=
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0

# Optional fallback, used only when the primary provider is rate-limited.
# AI_FALLBACK_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen3.5:4b

# Local addresses. The defaults match the README.
# VERITY_MCP_URL=http://127.0.0.1:8000/mcp
# VERITY_MCP_PORT=8000
